# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. Never commit real keys.

# --- database -----------------------------------------------------------------
# Local: matches docker-compose.yml (npm run db:up).
DATABASE_URL=postgresql://darbi:darbi@localhost:5434/darbi
# On Railway, set this in the app service's Variables tab as a reference:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}

# --- auth ---------------------------------------------------------------------
# Signs the JWTs. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST be set to a real value on Railway — changing it logs everyone out.
JWT_SECRET=dev-only-change-me

# --- Claude -------------------------------------------------------------------
# Server-side only. This must NEVER be prefixed VITE_ — anything named VITE_*
# is compiled into the browser bundle and would be publicly readable.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- app ----------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Password for the seeded judge accounts (student@ / company@ / career@darbi.jo)
DEMO_PASSWORD=darbi2026
